---
export const prerender = false;

import AffiliateLink from '../components/AffiliateLink.astro';
import ContentLayout from '../layouts/ContentLayout.astro';
import { brandEntityId, getBrandEntity } from '../data/brandEntities';
import { OPERATORS } from '../data/operators';
import { SITE } from '../data/site';
import {
  buildComparisonOperatorViews,
  cashMinimumCandidates,
  selectVerifiedEditorScores,
  selectUniqueSuperlative,
} from '../lib/homepage';
import { faqPageNode } from '../lib/schema';

const canonicalPath = '/';
const canonical = `${SITE.origin}/`;
const title = 'Compare Sweepstakes Casinos by Published Facts | Sweepstakes Wiz';
const description =
  'Compare reviewed sweepstakes casinos using sourced operator details, redemption terms, and available editor scores without filling evidence gaps.';
const primary = buildComparisonOperatorViews(OPERATORS, Astro.locals.usState);
const verifiedScores = selectVerifiedEditorScores(OPERATORS);
const lowestCashMinimum = selectUniqueSuperlative(
  cashMinimumCandidates(OPERATORS),
  {
    label: 'Lowest verified cash redemption minimum',
    asOf: new Date(),
    maxAgeDays: 90,
    metric: (minimum) => minimum.amount,
  },
);
const faq = [
  {
    q: 'What is a sweepstakes casino?',
    a: 'A sweepstakes casino is a social gaming site that usually uses free-play Gold Coins and promotional Sweeps Coins. Eligible Sweeps Coins may be redeemed under the operator’s rules. No purchase is necessary.',
  },
  {
    q: 'Does every operator have an editor score?',
    a: 'Yes. All 29 reviewed operators currently have an editor score. Scores are shown as supporting details and do not determine which operators appear in the comparison.',
  },
  {
    q: 'How are operators selected for this comparison?',
    a: 'Operators need a sourced name and company plus useful details in at least three decision areas. Entries with more available details appear first, with a stable name-based tie-break. Referral terms are not used.',
  },
  {
    q: 'Are sweepstakes casinos legal in every state?',
    a: 'No. Laws and operator rules differ by state. Check the state legality hub and the operator’s current official rules before playing or attempting a redemption.',
  },
];
const itemList = {
  '@type': 'ItemList',
  '@id': `${canonical}#comparison-operators`,
  name: 'Sweepstakes casino operators to compare',
  numberOfItems: primary.length,
  itemListOrder: 'https://schema.org/ItemListUnordered',
  itemListElement: primary.map((operator, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: operator.name,
    url: `${SITE.origin}/reviews/${operator.slug}/`,
    ...(getBrandEntity(operator.slug)
      ? { item: { '@id': brandEntityId(operator.slug) } }
      : {}),
  })),
};
const faqLd = faqPageNode(canonical, faq);
---
<ContentLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  breadcrumbs={[{ name: 'Home', path: '/' }]}
  heroTitle={'Compare <span class="accent">Sweepstakes Casinos</span>'}
  heroSubtitle="Compare reviewed operators through sourced details, redemption terms, and clearly labeled editor scores. Evidence gaps stay blank instead of becoming claims."
  pageType="CollectionPage"
  mainEntityId={`${canonical}#comparison-operators`}
  jsonLd={faqLd ? [itemList, faqLd] : [itemList]}
  variant="homepage"
  ogImage="/sweepstakeslogo/sweepstakeswiz-og.png"
>
  <Fragment slot="hero-extra">
    <p class="hero-kicker">
      <span class="hero-live-dot" aria-hidden="true"></span>
      Comparison by published facts
    </p>
    <div class="trust-pills">
      <div class="tp"><span class="ti" aria-hidden="true">🆓</span> No purchase necessary</div>
      <div class="tp"><span class="ti" aria-hidden="true">🎰</span> 29 reviewed operators</div>
      <div class="tp"><span class="ti" aria-hidden="true">📊</span> Editor scores /100</div>
      <div class="tp"><span class="ti" aria-hidden="true">🗺️</span> Check your state</div>
      <div class="tp"><span class="ti" aria-hidden="true">🛡️</span> 21+</div>
    </div>
  </Fragment>

  <section id="answer" class="answer" aria-labelledby="answer-title">
    <h2 id="answer-title">The short answer</h2>
    <p>
      A useful <strong>sweepstakes casino comparison</strong> starts with state
      eligibility, no-purchase rules, redemption terms and the quality of the
      available sources. The cards below are a research starting point, not a claim
      that every listed operator has been assigned a complete score.
    </p>
  </section>

  <section id="comparison" aria-labelledby="comparison-title">
    <p class="eyebrow">Operators to compare</p>
    <h2 id="comparison-title">A broader evidence-based comparison</h2>
    <p>
      We include operators with a sourced name and company plus useful details in at
      least three decision areas. Entries with more available details appear first.
      Referral terms are not an input, and blank cells are not inferred.
    </p>
    <div class="crit-row">
      <div class="crit">
        <div class="crit-ico" aria-hidden="true">⚡</div>
        <div>
          <div class="crit-name">Redemption terms</div>
          <div class="crit-val">Published estimates only</div>
        </div>
      </div>
      <div class="crit">
        <div class="crit-ico" aria-hidden="true">🎁</div>
        <div>
          <div class="crit-name">Welcome offer</div>
          <div class="crit-val">Sourced signup copy</div>
        </div>
      </div>
      <div class="crit">
        <div class="crit-ico" aria-hidden="true">🎰</div>
        <div>
          <div class="crit-name">Game library</div>
          <div class="crit-val">When a count is published</div>
        </div>
      </div>
      <div class="crit">
        <div class="crit-ico" aria-hidden="true">🗺️</div>
        <div>
          <div class="crit-name">Eligibility</div>
          <div class="crit-val">Geo policy + operator rules</div>
        </div>
      </div>
    </div>
    <div class="table-wrap" tabindex="0" aria-label="Scrollable operator comparison">
      <table class="home-compare">
        <caption>
          Reviewed operators with enough published information to support comparison.
        </caption>
        <thead>
          <tr>
            <th scope="col">Operator</th>
            <th scope="col">Editor score</th>
            <th scope="col">Welcome offer</th>
            <th scope="col">Redemption minimum</th>
            <th scope="col">Published redemption estimate</th>
            <th scope="col">Games</th>
            <th scope="col">Next step</th>
          </tr>
        </thead>
        <tbody
          data-comparison-list
          data-item-list={`${canonical}#comparison-operators`}
          data-item-list-order="https://schema.org/ItemListUnordered"
        >
          {primary.map((operator, index) => (
            <tr
              class="home-op"
              data-item-position={index + 1}
              data-item-name={operator.name}
              data-item-url={`${SITE.origin}/reviews/${operator.slug}/`}
            >
              <th scope="row">
                {operator.logoSrc ? (
                  <img
                    class="home-op-logo"
                    src={operator.logoSrc}
                    alt={`${operator.name} logo`}
                    width="128"
                    height="76"
                    loading={index < 2 ? 'eager' : 'lazy'}
                  />
                ) : null}
                <a href={`/reviews/${operator.slug}/`}>{operator.name}</a>
              </th>
              <td data-label="Editor score">{operator.editorScore ?? <span aria-label="Details unavailable">—</span>}</td>
              <td data-label="Welcome offer">{operator.welcomeOffer ?? <span aria-label="Details unavailable">—</span>}</td>
              <td data-label="Redemption minimum">{operator.redemptionMinimum ?? <span aria-label="Details unavailable">—</span>}</td>
              <td data-label="Published redemption estimate">{operator.publishedRedemptionTiming ?? <span aria-label="Details unavailable">—</span>}</td>
              <td data-label="Games">{operator.gameCount ?? <span aria-label="Details unavailable">—</span>}</td>
              <td data-label="Next step">
                {operator.hasPartner ? (
                  <AffiliateLink
                    slug={operator.slug}
                    label={`Visit ${operator.name}`}
                    class="btn-claim"
                    clickId="homepage-comparison"
                    showUnavailableNote
                  />
                ) : null}
                <a class="btn-review" href={`/reviews/${operator.slug}/`}>Read review</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p><a href="/best/sweepstakes-casinos/">Open the deeper comparison guide</a>.</p>
  </section>

  <section id="score-context" aria-labelledby="score-context-title">
    <p class="eyebrow">Available editor scores</p>
    <h2 id="score-context-title">Scores shown as supporting details</h2>
    <p>
      A score appears only where our records support one consistent Sweepstakes Wiz
      value. This alphabetical list does not define the complete comparison above.
    </p>
    <ul class="score-list">
      {verifiedScores.map((operator) => (
        <li>
          <a href={`/reviews/${operator.slug}/`}>{operator.name}</a>
          <strong>{operator.score}/100</strong>
        </li>
      ))}
    </ul>
  </section>

  <section id="use-cases" aria-labelledby="use-cases-title">
    <p class="eyebrow">Evidence-gated use cases</p>
    <h2 id="use-cases-title">A winner appears only with current comparable evidence</h2>
    {lowestCashMinimum ? (
      <article class="use-case-card">
        <p>{lowestCashMinimum.label}</p>
        <h3><a href={`/reviews/${lowestCashMinimum.slug}/`}>{lowestCashMinimum.name}</a></h3>
        <p>
          Published minimum: {lowestCashMinimum.value.amount}{' '}
          {lowestCashMinimum.value.currency}. This is a published threshold, not an
          observed payout.
        </p>
      </article>
    ) : (
      <p class="honesty-note">
        No single winner is shown because comparable freshness dates are unavailable.
      </p>
    )}
  </section>

  <section id="methodology" aria-labelledby="methodology-title">
    <p class="eyebrow">Methodology and trust</p>
    <h2 id="methodology-title">Scores are earned, not backfilled</h2>
    <p>
      We assess published redemption terms, offer clarity, game experience and trust
      signals under our <a href="/how-we-rate/">rating methodology</a>. Affiliate
      relationships never resolve missing data or change rank. Read our
      <a href="/editorial-policy/">editorial policy</a> and
      <a href="/legal/affiliate-disclosure/">affiliate disclosure</a>.
    </p>
  </section>

  <section id="legality" aria-labelledby="legality-title">
    <p class="eyebrow">Essential legality and safety</p>
    <h2 id="legality-title">Check two layers before you play</h2>
    <ul>
      <li>Your state’s current treatment of sweepstakes casino play and promotion.</li>
      <li>The operator’s own restricted-state list and official sweepstakes rules.</li>
      <li>No purchase is necessary. Sweeps Coins have no cash value until eligible redemption.</li>
      <li>Set limits and call <strong>1-800-GAMBLER</strong> if play stops being fun.</li>
    </ul>
    <p>
      Start with the <a href="/state-legality/">state legality hub</a> and our
      <a href="/responsible-gaming/">responsible gaming resources</a>.
    </p>
  </section>

  <section id="buyer-guidance" aria-labelledby="buyer-guidance-title">
    <p class="eyebrow">Buyer guidance</p>
    <h2 id="buyer-guidance-title">Choose by the constraint that matters to you</h2>
    <div class="guidance-grid">
      <article>
        <h3>Start with eligibility</h3>
        <p>A generous offer has no value if either our geo policy or the operator’s rules exclude your state.</p>
      </article>
      <article>
        <h3>Compare redemption routes</h3>
        <p>Review the minimum, identity checks, payment method and published estimate together.</p>
      </article>
      <article>
        <h3>Read offer terms</h3>
        <p>Gold Coin totals are not cash value. Check Sweeps Coin amounts, playthrough and expiry.</p>
      </article>
    </div>
  </section>

  <section id="faq" aria-labelledby="faq-title">
    <p class="eyebrow">Quick answers</p>
    <h2 id="faq-title">Frequently asked questions</h2>
    <div class="faq-list">
      {faq.map((item) => (
        <article>
          <h3>{item.q}</h3>
          <p>{item.a}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="specialist-hubs" aria-labelledby="specialist-hubs-title">
    <p class="eyebrow">Go deeper</p>
    <h2 id="specialist-hubs-title">Specialist research hubs</h2>
    <nav class="hub-links" aria-label="Specialist sweepstakes casino hubs">
      <a href="/reviews/">All casino reviews</a>
      <a href="/best/sweepstakes-casinos/">Full best-casinos comparison</a>
      <a href="/new/">New sweepstakes casinos</a>
      <a href="/bonuses/no-deposit/">No-deposit offers</a>
      <a href="/guides/">Guides</a>
      <a href="/tools/">Decision tools</a>
    </nav>
  </section>

  <style>
    :global(body.layout-home){
      background:linear-gradient(180deg,#e8eef7 0%,#d5deec 100%);
    }
    :global(.layout-home .home-hero){
      padding:56px 20px 52px;
      background:radial-gradient(ellipse at 50% 0%,#16325a 0%,#0a1628 62%);
      text-align:center;
    }
    :global(.layout-home .home-hero)::before{
      content:'';
      position:absolute;inset:0;pointer-events:none;
      background-image:
        radial-gradient(2px 2px at 8% 20%,rgba(251,191,36,.85),transparent),
        radial-gradient(1.5px 1.5px at 20% 70%,rgba(96,165,250,.7),transparent),
        radial-gradient(2px 2px at 35% 12%,rgba(251,191,36,.55),transparent),
        radial-gradient(1.5px 1.5px at 55% 80%,rgba(251,191,36,.7),transparent),
        radial-gradient(2px 2px at 70% 30%,rgba(96,165,250,.6),transparent),
        radial-gradient(1.5px 1.5px at 82% 65%,rgba(251,191,36,.5),transparent),
        radial-gradient(2px 2px at 92% 15%,rgba(251,191,36,.8),transparent);
      opacity:.75;
    }
    :global(.layout-home .home-hero .page-hero-inner){max-width:860px;}
    :global(.layout-home .home-hero h1){
      font-size:clamp(1.85rem,4.6vw,3rem);
      text-shadow:0 0 28px rgba(251,191,36,.28);
    }
    :global(.layout-home .home-hero .page-hero-sub){max-width:640px;margin-bottom:18px;}
    :global(.layout-home .home-main){max-width:1180px;padding-top:28px;}
    :global(.layout-home .home-card){
      border-top:3px solid #fbbf24;
      padding:32px 28px 40px;
      background:linear-gradient(180deg,#fff,#f7fafc);
    }
    :global(.layout-home .home-card table.home-compare){
      display:block;
      width:100%;
      min-width:0;
      margin:0;
      border:0;
      overflow:visible;
    }
    :global(.layout-home .home-card table.home-compare thead),
    :global(.layout-home .home-card table.home-compare tbody),
    :global(.layout-home .home-card table.home-compare caption){
      display:block;width:100%;
    }
    .hero-kicker{
      display:inline-flex;align-items:center;gap:8px;
      background:rgba(16,185,129,.12);border:1px solid rgba(16,185,129,.35);
      color:#6ee7b7;border-radius:100px;padding:6px 14px;
      font-size:.72rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;
      margin:0 auto 16px;
    }
    .hero-live-dot{width:7px;height:7px;background:#34d399;border-radius:50%;animation:pulse 1.8s infinite;}
    @keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(52,211,153,.55);}50%{box-shadow:0 0 0 7px rgba(52,211,153,0);}}
    .trust-pills{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin-top:4px;}
    .tp{
      display:flex;align-items:center;gap:6px;
      background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);
      border-radius:10px;padding:6px 13px;
      font-size:.74rem;font-weight:700;color:rgba(255,255,255,.88);
    }
    .tp .ti{font-size:.9rem;}
    section{scroll-margin-top:1rem;margin:0 0 3rem;}
    .answer{
      background:#0a1628;color:#e2e8f0;border-radius:16px;padding:1.25rem 1.4rem;
      box-shadow:0 12px 32px rgba(10,22,40,.18);
    }
    .answer h2{color:#fbbf24;margin-top:0;}
    .answer p{margin-bottom:0;}
    .eyebrow{margin:0 0 .25rem;color:#9a6700;font-size:.76rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase;}
    .crit-row{
      display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;
      background:#0a1628;border:1px solid rgba(251,191,36,.22);border-radius:18px;
      padding:16px 18px;margin:1.1rem 0 1.25rem;color:#fff;
    }
    .crit{display:flex;align-items:center;gap:10px;}
    .crit-ico{font-size:1.35rem;}
    .crit-name{font-weight:800;font-size:.8rem;}
    .crit-val{font-size:.68rem;color:#94a3b8;font-weight:600;}
    .home-compare caption{
      text-align:left;padding:.85rem 1rem;background:#0a1628;color:#e2e8f0;
      border-radius:12px 12px 0 0;font-size:.86rem;
    }
    .home-compare thead{
      position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;
      clip:rect(0,0,0,0);white-space:nowrap;border:0;
    }
    .home-compare tbody{display:flex;flex-direction:column;gap:16px;padding-top:14px;}
    .home-op{
      display:grid;grid-template-columns:180px minmax(0,1fr) 200px;
      background:linear-gradient(165deg,#12233f,#0a1628 55%,#07101f);
      border:1px solid rgba(251,191,36,.22);border-radius:18px;
      overflow:hidden;color:#fff;box-shadow:0 12px 32px rgba(7,16,32,.28);
      position:relative;
    }
    .home-op::before{
      content:'';position:absolute;top:0;left:0;right:0;height:3px;
      background:linear-gradient(90deg,#fbbf24,#f59e0b);
    }
    .home-op:hover{border-color:rgba(251,191,36,.42);transform:translateY(-2px);transition:transform .2s,border-color .2s;}
    .home-op th,.home-op td{
      border:0;background:transparent;color:inherit;padding:1rem .9rem;vertical-align:middle;
    }
    .home-op th{
      display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.55rem;
      text-align:center;border-right:1px solid rgba(255,255,255,.08);
      background:linear-gradient(170deg,#16325a,#0a1628);
      font-weight:800;padding:1.15rem .9rem 2.4rem;
    }
    .home-op th a{color:#fff;text-decoration:none;font-size:.82rem;letter-spacing:.03em;}
    .home-op th a:hover{color:#fbbf24;}
    .home-op-logo{
      width:128px;height:76px;object-fit:contain;border-radius:8px;
      filter:drop-shadow(0 4px 12px rgba(0,0,0,.45));
    }
    .home-op td:nth-child(2){
      position:absolute;left:18px;bottom:14px;
      padding:0;font-weight:800;color:#fbbf24;font-size:.78rem;
    }
    .home-op td:nth-child(3){
      grid-column:2;font-family:'Sora',sans-serif;font-weight:800;
      font-size:clamp(1rem,1.6vw,1.22rem);color:#fff;padding:1.35rem 1rem .2rem;
    }
    .home-op td:nth-child(4),
    .home-op td:nth-child(5),
    .home-op td:nth-child(6){
      grid-column:2;padding:.15rem 1rem;
      color:#cbd5e1;font-size:.82rem;
    }
    .home-op td:nth-child(4)::before,
    .home-op td:nth-child(5)::before,
    .home-op td:nth-child(6)::before{
      content:attr(data-label) ': ';
      font-size:.68rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#94a3b8;
    }
    .home-op td:nth-child(6){padding-bottom:1.2rem;}
    .home-op td:nth-child(7){
      grid-column:3;grid-row:1 / span 5;
      display:flex;flex-direction:column;justify-content:center;gap:.65rem;
      background:linear-gradient(180deg,#12243f,#07101f);
      border-left:1px solid rgba(255,255,255,.08);
      padding:1.2rem 1rem;
    }
    .home-op :global(.btn-claim),
    .home-op :global(.affiliate-cta){
      display:flex;align-items:center;justify-content:center;
      padding:.85rem .7rem;border-radius:12px;
      background:linear-gradient(135deg,#fbbf24,#f59e0b);
      color:#0a1628;font-weight:900;text-decoration:none;text-transform:uppercase;
      letter-spacing:.03em;box-shadow:0 4px 16px rgba(251,191,36,.32);
    }
    .home-op :global(.btn-claim:hover),
    .home-op :global(.affiliate-cta:hover){transform:translateY(-1px);box-shadow:0 8px 24px rgba(251,191,36,.45);}
    .home-op :global(.affiliate-unavailable){font-size:.75rem;color:#fecaca;margin:0;}
    .btn-review{
      display:block;text-align:center;font-size:.76rem;font-weight:700;
      color:#94a3b8;text-decoration:none;padding:.45rem;border:1px solid rgba(255,255,255,.14);
      border-radius:8px;
    }
    .btn-review:hover{color:#7dd3fc;border-color:rgba(125,211,252,.4);}
    a:focus-visible,.table-wrap:focus-visible,.btn-review:focus-visible,
    .home-op :global(.affiliate-cta:focus-visible){outline:3px solid #d97706;outline-offset:3px;}
    .honesty-note,.use-case-card{border-left:4px solid #fbbf24;background:#fffbeb;padding:1rem 1.1rem;border-radius:0 12px 12px 0;}
    .score-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:.75rem;list-style:none;padding:0;}
    .score-list li{display:flex;justify-content:space-between;gap:1rem;border:1px solid #e2e8f0;border-radius:10px;padding:.75rem .9rem;}
    .table-wrap{max-width:100%;overflow-x:auto;border:0;border-radius:12px;}
    .guidance-grid,.faq-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;}
    .guidance-grid article,.faq-list article{border:1px solid #e2e8f0;border-radius:12px;padding:1rem;}
    .guidance-grid h3,.faq-list h3{margin-top:0;}
    .hub-links{display:flex;flex-wrap:wrap;gap:.65rem;}
    .hub-links a{background:#0a1628;color:#fbbf24;border-radius:999px;padding:.55rem .85rem;text-decoration:none;font-weight:700;}
    @media(max-width:900px){
      .crit-row{grid-template-columns:repeat(2,minmax(0,1fr));}
      .home-op{grid-template-columns:1fr;}
      .home-op th{border-right:0;border-bottom:1px solid rgba(255,255,255,.08);flex-direction:row;justify-content:flex-start;padding:1.15rem 1rem .85rem;}
      .home-op-logo{width:88px;height:56px;}
      .home-op td:nth-child(2){position:static;padding:.2rem 1rem;grid-column:1;}
      .home-op td:nth-child(3),
      .home-op td:nth-child(4),
      .home-op td:nth-child(5),
      .home-op td:nth-child(6),
      .home-op td:nth-child(7){grid-column:1;}
      .home-op td:nth-child(7){grid-row:auto;border-left:0;border-top:1px solid rgba(255,255,255,.08);}
    }
    @media(max-width:760px){
      .guidance-grid,.faq-list{grid-template-columns:1fr;}
    }
    @media(max-width:480px){
      .crit-row{grid-template-columns:1fr;}
      section{margin-bottom:2.25rem;}
    }
  </style>
</ContentLayout>
