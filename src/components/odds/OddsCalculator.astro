---
// All behavior is bundled below; this component has no server props.
---
<section class="odds-calculator" data-odds-calculator aria-labelledby="odds-calculator-title">
  <div class="odds-workstation">
    <div class="odds-form-panel">
      <p class="odds-brand-kicker">SweepstakesWiz tool</p>
      <h2 id="odds-calculator-title">Calculate your sweepstakes odds</h2>
      <p class="odds-intro">
        This calculates the chance that at least one of your entries is selected when unique winning
        entries are drawn without replacement.
      </p>

      <div class="odds-error-summary" data-error-summary tabindex="-1" role="alert" hidden>
        <h3>Check the highlighted fields</h3>
        <ul data-error-list></ul>
      </div>

      <noscript>
        <p class="odds-noscript">
          The calculator needs JavaScript to calculate a result. The methodology, examples, FAQ,
          disclosures, casino reviews, and related guides below remain available.
        </p>
      </noscript>

      <form data-odds-form method="dialog" novalidate>
        <fieldset class="odds-mode-seg">
          <legend id="odds-mode-label">Entry pool mode</legend>
          <div class="odds-mode-seg-track" role="radiogroup" aria-labelledby="odds-mode-label">
            <label class="odds-mode-option">
              <input type="radio" name="poolMode" value="known" checked data-pool-mode-known />
              <span>Known total</span>
            </label>
            <label class="odds-mode-option">
              <input
                id="odds-estimated-toggle"
                type="radio"
                name="poolMode"
                value="estimated"
                data-estimated-toggle
                aria-controls="odds-pool"
                aria-describedby="odds-estimated-instructions"
              />
              <span>Estimate</span>
            </label>
          </div>
          <p id="odds-estimated-instructions" class="odds-mode-instructions">
            Use this when the total entry pool is unknown; enter your best estimate including your entries.
          </p>
        </fieldset>

        <div class="odds-grid">
          <div class="odds-field" data-field-wrap="entries">
            <label for="odds-entries">Your entries</label>
            <input id="odds-entries" name="entries" type="text" inputmode="numeric"
              pattern="[0-9]*" autocomplete="off" aria-describedby="odds-entries-hint odds-entries-error" />
            <p id="odds-entries-hint" class="odds-hint">Include free and purchase-associated entries.</p>
            <p id="odds-entries-error" class="odds-field-error" data-error-for="entries" hidden></p>
          </div>

          <fieldset class="odds-field odds-pool-field">
            <legend>Entry pool</legend>
            <label for="odds-pool" data-pool-label>Total entries</label>
            <input id="odds-pool" name="pool" type="text" inputmode="numeric"
              pattern="[0-9]*" autocomplete="off" aria-describedby="odds-pool-hint odds-pool-error" />
            <p id="odds-pool-hint" class="odds-hint" data-pool-hint aria-live="polite" role="status">
              Include your entries in the drawing total.
            </p>
            <p id="odds-pool-error" class="odds-field-error" data-error-for="pool" hidden></p>
          </fieldset>

          <div class="odds-field" data-field-wrap="prizes">
            <label for="odds-prizes">Number of prizes</label>
            <input id="odds-prizes" name="prizes" type="text" inputmode="numeric"
              pattern="[0-9]*" autocomplete="off" value="1"
              aria-describedby="odds-prizes-hint odds-prizes-error" />
            <p id="odds-prizes-hint" class="odds-hint">Each prize selects one unique winning entry.</p>
            <p id="odds-prizes-error" class="odds-field-error" data-error-for="prizes" hidden></p>
          </div>
        </div>

        <details class="odds-options">
          <summary>More options</summary>
          <div class="odds-option">
            <label>
              <input type="checkbox" data-entry-mix-toggle />
              Compare free vs paid entries
            </label>
            <div data-entry-mix-fields hidden>
              <label for="odds-free-entries">How many of your entries were free/AMOE?</label>
              <input id="odds-free-entries" name="freeEntries" type="text" inputmode="numeric"
                pattern="[0-9]*" autocomplete="off" disabled
                aria-describedby="odds-free-entries-hint odds-free-entries-error" />
              <p id="odds-free-entries-hint" class="odds-hint">
                Purchase-associated entries are derived as your entries minus free entries.
              </p>
              <p id="odds-free-entries-error" class="odds-field-error"
                data-error-for="freeEntries" hidden></p>
            </div>
          </div>

          <div class="odds-option">
            <label>
              <input type="checkbox" data-drawings-toggle />
              Multiple drawings
            </label>
            <div data-drawings-fields hidden>
              <label for="odds-drawings">Number of independent drawings</label>
              <input id="odds-drawings" name="drawings" type="text" inputmode="numeric"
                pattern="[0-9]*" autocomplete="off" disabled
                aria-describedby="odds-drawings-hint odds-drawings-error" />
              <p id="odds-drawings-hint" class="odds-hint">
                Assumes each drawing is independent with the same pool and probability.
              </p>
              <p id="odds-drawings-error" class="odds-field-error"
                data-error-for="drawings" hidden></p>
            </div>
          </div>
        </details>

        <p class="odds-assumption">Unique winning entries · drawn without replacement</p>
        <button class="odds-submit" type="submit">Calculate my odds</button>
      </form>
    </div>

    <aside class="odds-billboard-panel" aria-label="Calculation result">
      <div class="odds-result-placeholder" data-result-placeholder>
        <p class="odds-bill-k">Your result</p>
        <p class="odds-placeholder-copy">Enter your numbers and calculate to see your odds here.</p>
      </div>

      <section class="odds-result" data-result aria-live="polite" hidden>
        <div class="odds-charge" data-charge hidden aria-hidden="true">
          <span class="odds-charge-bar"></span>
        </div>
        <div class="odds-billboard" data-billboard>
          <p class="odds-bill-k">Your chance</p>
          <h3 tabindex="-1" data-result-heading></h3>
          <p class="odds-result-percent" data-result-percent></p>
          <p data-result-assumption></p>
          <div data-entry-mix-result hidden>
            <h3>Free and purchase-associated entry comparison</h3>
            <dl>
              <div><dt data-mix-label-combined>Combined current-pool odds</dt><dd data-mix-combined></dd></div>
              <div><dt data-mix-label-free-current>Free-only odds in the same current pool</dt><dd data-mix-free-current></dd></div>
              <div><dt data-mix-label-no-purchase>No-purchase counterfactual</dt><dd data-mix-no-purchase></dd></div>
            </dl>
            <p class="odds-hint" data-entry-mix-note hidden></p>
          </div>
          <p data-drawings-result hidden></p>
        </div>
      </section>
    </aside>
  </div>
</section>

<script>
  import {
    entryMixDisplayLabels,
    formatDrawingsResult,
    formatEntryMixValue,
    formatEstimatedChanceHeadline,
    formatEstimatedProbabilityRange,
    formatKnownChanceHeadline,
    ODDS_EVENT_CALCULATION_COMPLETED,
    ODDS_EVENT_OPTIONS_OPENED,
    RESULT_INVALIDATING_INPUT_IDS,
  } from '../../lib/oddsCalculatorUi';
  import {
    entryMixProbabilities,
    estimateProbabilityRange,
    exactWinProbability,
    formatChance,
    repeatProbability,
    validateCalculatorInput,
    type OddsField,
    type ValidationIssue,
  } from '../../lib/sweepstakesOdds';

  declare global {
    interface Window {
      gtag?: (...args: unknown[]) => void;
    }
  }

  function sendEvent(name: string, params: Record<string, string | boolean>): void {
    try {
      window.gtag?.('event', name, params);
    } catch {
      // Analytics is optional and must never block calculation.
    }
  }

  function initialize(root: HTMLElement): void {
    const form = root.querySelector<HTMLFormElement>('[data-odds-form]')!;
    const pool = root.querySelector<HTMLInputElement>('#odds-pool')!;
    const poolLabel = root.querySelector<HTMLElement>('[data-pool-label]')!;
    const poolHint = root.querySelector<HTMLElement>('[data-pool-hint]')!;
    const estimatedToggle = root.querySelector<HTMLInputElement>('[data-estimated-toggle]')!;
    const knownToggle = root.querySelector<HTMLInputElement>('[data-pool-mode-known]')!;
    const entryMixToggle = root.querySelector<HTMLInputElement>('[data-entry-mix-toggle]')!;
    const drawingsToggle = root.querySelector<HTMLInputElement>('[data-drawings-toggle]')!;
    const resultPlaceholder = root.querySelector<HTMLElement>('[data-result-placeholder]')!;
    const chargeEl = root.querySelector<HTMLElement>('[data-charge]')!;
    const billboard = root.querySelector<HTMLElement>('[data-billboard]')!;
    const opened = new Set<'entry_mix' | 'multiple_drawings'>();
    let revealTimer: number | undefined;

    const fieldId: Record<OddsField, string> = {
      entries: 'odds-entries',
      pool: 'odds-pool',
      prizes: 'odds-prizes',
      freeEntries: 'odds-free-entries',
      drawings: 'odds-drawings',
    };

    function prefersReducedMotion(): boolean {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    function hideResult(): void {
      if (revealTimer !== undefined) {
        window.clearTimeout(revealTimer);
        revealTimer = undefined;
      }
      const resultRegion = root.querySelector<HTMLElement>('[data-result]')!;
      resultRegion.hidden = true;
      resultPlaceholder.hidden = false;
      chargeEl.hidden = true;
      billboard.classList.remove('is-charging', 'is-ready');
      root.querySelector<HTMLElement>('[data-result-heading]')!.textContent = '';
      root.querySelector<HTMLElement>('[data-result-percent]')!.textContent = '';
      root.querySelector<HTMLElement>('[data-result-assumption]')!.textContent = '';
      const mixRegion = root.querySelector<HTMLElement>('[data-entry-mix-result]')!;
      mixRegion.hidden = true;
      root.querySelector<HTMLElement>('[data-mix-combined]')!.textContent = '';
      root.querySelector<HTMLElement>('[data-mix-free-current]')!.textContent = '';
      root.querySelector<HTMLElement>('[data-mix-no-purchase]')!.textContent = '';
      const mixNote = root.querySelector<HTMLElement>('[data-entry-mix-note]')!;
      mixNote.hidden = true;
      mixNote.textContent = '';
      const drawingsResult = root.querySelector<HTMLElement>('[data-drawings-result]')!;
      drawingsResult.hidden = true;
      drawingsResult.textContent = '';
    }

    function clearErrors(): void {
      root.querySelector<HTMLElement>('[data-error-summary]')!.hidden = true;
      root.querySelector<HTMLElement>('[data-error-list]')!.replaceChildren();
      root.querySelectorAll<HTMLElement>('[data-error-for]').forEach((node) => {
        node.hidden = true;
        node.textContent = '';
      });
      Object.values(fieldId).forEach((id) => {
        root.querySelector<HTMLElement>(`#${id}`)?.removeAttribute('aria-invalid');
      });
    }

    function showErrors(issues: ValidationIssue[]): void {
      hideResult();
      clearErrors();
      const summary = root.querySelector<HTMLElement>('[data-error-summary]')!;
      const list = root.querySelector<HTMLUListElement>('[data-error-list]')!;
      summary.hidden = false;
      for (const issue of issues) {
        const input = root.querySelector<HTMLElement>(`#${fieldId[issue.field]}`);
        const inline = root.querySelector<HTMLElement>(`[data-error-for="${issue.field}"]`);
        const details = input?.closest('details');
        if (details) details.open = true;
        input?.setAttribute('aria-invalid', 'true');
        if (inline) {
          inline.textContent = `Error: ${issue.message}`;
          inline.hidden = false;
        }
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = `#${fieldId[issue.field]}`;
        link.textContent = issue.message;
        item.append(link);
        list.append(item);
      }
      summary.focus();
    }

    function setAdvanced(
      toggle: HTMLInputElement,
      selector: string,
      option: 'entry_mix' | 'multiple_drawings',
    ): void {
      const fields = root.querySelector<HTMLElement>(selector)!;
      fields.hidden = !toggle.checked;
      fields.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
        input.disabled = !toggle.checked;
      });
      if (toggle.checked && !opened.has(option)) {
        opened.add(option);
        sendEvent(ODDS_EVENT_OPTIONS_OPENED, { option_name: option });
      }
      hideResult();
      clearErrors();
    }

    function syncPoolMode(): void {
      pool.value = '';
      poolLabel.textContent = estimatedToggle.checked
        ? 'Your best estimate of total entries'
        : 'Total entries';
      poolHint.textContent = estimatedToggle.checked
        ? 'Include your entries; the calculator applies stated 0.8× and 1.25× assumptions.'
        : 'Include your entries in the drawing total.';
      root.classList.toggle('is-estimate-mode', estimatedToggle.checked);
      hideResult();
      clearErrors();
    }

    for (const id of RESULT_INVALIDATING_INPUT_IDS) {
      root.querySelector<HTMLInputElement>(`#${id}`)?.addEventListener('input', hideResult);
    }

    estimatedToggle.addEventListener('change', () => {
      syncPoolMode();
    });
    knownToggle.addEventListener('change', () => {
      syncPoolMode();
    });
    entryMixToggle.addEventListener('change', () =>
      setAdvanced(entryMixToggle, '[data-entry-mix-fields]', 'entry_mix'));
    drawingsToggle.addEventListener('change', () =>
      setAdvanced(drawingsToggle, '[data-drawings-fields]', 'multiple_drawings'));

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const result = validateCalculatorInput({
        poolMode: estimatedToggle.checked ? 'estimated' : 'known',
        entries: String(data.get('entries') ?? ''),
        pool: String(data.get('pool') ?? ''),
        prizes: String(data.get('prizes') ?? ''),
        entryMixActive: entryMixToggle.checked,
        freeEntries: entryMixToggle.checked ? String(data.get('freeEntries') ?? '') : undefined,
        multipleDrawingsActive: drawingsToggle.checked,
        drawings: drawingsToggle.checked ? String(data.get('drawings') ?? '') : undefined,
      });
      if (!result.ok) {
        hideResult();
        showErrors(result.issues);
        return;
      }
      clearErrors();

      const scenario = result.value;
      const resultRegion = root.querySelector<HTMLElement>('[data-result]')!;
      const heading = root.querySelector<HTMLElement>('[data-result-heading]')!;
      const percent = root.querySelector<HTMLElement>('[data-result-percent]')!;
      const assumption = root.querySelector<HTMLElement>('[data-result-assumption]')!;
      resultRegion.hidden = false;
      resultPlaceholder.hidden = true;
      let singleProbability: number;

      if (scenario.poolMode === 'known') {
        singleProbability = exactWinProbability({
          entries: scenario.entries,
          totalEntries: scenario.pool,
          prizes: scenario.prizes,
        });
        const display = formatChance(singleProbability);
        heading.textContent = formatKnownChanceHeadline(display);
        percent.textContent = `Calculated probability: ${display.percent}.`;
        assumption.textContent =
          'Known-pool calculation: unique winning entries drawn without replacement.';
      } else {
        const range = estimateProbabilityRange({
          entries: scenario.entries,
          estimate: scenario.pool,
          prizes: scenario.prizes,
        });
        singleProbability = range.baseChance;
        heading.textContent = formatEstimatedChanceHeadline(range);
        percent.textContent = formatEstimatedProbabilityRange(range);
        assumption.textContent =
          'Estimate assumptions only: 0.8×, entered total, and 1.25× total entries. This is not a confidence interval or operator data.';
      }

      const mixRegion = root.querySelector<HTMLElement>('[data-entry-mix-result]')!;
      const mixCombined = root.querySelector<HTMLElement>('[data-mix-combined]')!;
      const mixFreeCurrent = root.querySelector<HTMLElement>('[data-mix-free-current]')!;
      const mixNoPurchase = root.querySelector<HTMLElement>('[data-mix-no-purchase]')!;
      const mixNote = root.querySelector<HTMLElement>('[data-entry-mix-note]')!;
      mixRegion.hidden = !scenario.entryMixActive;
      mixCombined.textContent = '';
      mixFreeCurrent.textContent = '';
      mixNoPurchase.textContent = '';
      mixNote.hidden = true;
      mixNote.textContent = '';
      if (scenario.entryMixActive && scenario.freeEntries !== undefined) {
        const labels = entryMixDisplayLabels(scenario.poolMode);
        root.querySelector<HTMLElement>('[data-mix-label-combined]')!.textContent = labels.combined;
        root.querySelector<HTMLElement>('[data-mix-label-free-current]')!.textContent = labels.freeCurrent;
        root.querySelector<HTMLElement>('[data-mix-label-no-purchase]')!.textContent = labels.noPurchase;
        if (labels.sectionNote) {
          mixNote.textContent = labels.sectionNote;
          mixNote.hidden = false;
        } else {
          mixNote.textContent = '';
          mixNote.hidden = true;
        }

        const mix = entryMixProbabilities({
          entries: scenario.entries,
          totalEntries: scenario.pool,
          prizes: scenario.prizes,
          freeEntries: scenario.freeEntries,
        });
        const formatMix = (probability: number) => {
          const formatted = formatChance(probability);
          return formatEntryMixValue(scenario.poolMode, formatted.reciprocal, formatted.percent);
        };
        mixCombined.textContent = formatMix(mix.combined);
        mixFreeCurrent.textContent = formatMix(mix.freeOnlyCurrentPool);
        mixNoPurchase.textContent = formatMix(mix.noPurchase);
      }

      const drawingsResult = root.querySelector<HTMLElement>('[data-drawings-result]')!;
      drawingsResult.hidden = !scenario.multipleDrawingsActive;
      drawingsResult.textContent = '';
      if (scenario.multipleDrawingsActive && scenario.drawings !== undefined) {
        const repeated = repeatProbability(singleProbability, scenario.drawings);
        const repeatedFormatted = formatChance(repeated);
        drawingsResult.textContent = formatDrawingsResult(
          scenario.poolMode,
          repeatedFormatted.reciprocal,
          repeatedFormatted.percent,
        );
      }

      const finishReveal = () => {
        revealTimer = undefined;
        chargeEl.hidden = true;
        billboard.classList.remove('is-charging');
        billboard.classList.add('is-ready');
        heading.focus();
        sendEvent(ODDS_EVENT_CALCULATION_COMPLETED, {
          pool_mode: scenario.poolMode,
          entry_mix_active: scenario.entryMixActive,
          multiple_drawings_active: scenario.multipleDrawingsActive,
        });
      };

      if (revealTimer !== undefined) {
        window.clearTimeout(revealTimer);
        revealTimer = undefined;
      }

      if (prefersReducedMotion()) {
        finishReveal();
      } else {
        chargeEl.hidden = false;
        billboard.classList.remove('is-ready');
        billboard.classList.add('is-charging');
        revealTimer = window.setTimeout(finishReveal, 420);
      }
    });
  }

  document.querySelectorAll<HTMLElement>('[data-odds-calculator]').forEach(initialize);
</script>

<style>
  .odds-calculator{
    --odds-navy:#0a1628;
    --odds-navy-2:#12233d;
    --odds-gold:#fbbf24;
    --odds-gold-2:#f59e0b;
    --odds-ink:#e8eef8;
    --odds-muted:rgba(232,238,248,.62);
    border:1px solid rgba(251,191,36,.28);
    border-radius:20px;
    background:
      radial-gradient(circle at 88% 12%,rgba(251,191,36,.22),transparent 32%),
      radial-gradient(circle at 8% 90%,rgba(26,86,219,.18),transparent 36%),
      linear-gradient(165deg,#0c1a30 0%,#07101f 55%,#0a1628 100%);
    padding:22px;
    margin:0 0 26px;
    box-shadow:0 18px 48px rgba(7,16,32,.35);
    color:var(--odds-ink);
  }
  .odds-workstation{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:18px;align-items:stretch}
  .odds-form-panel,.odds-billboard-panel{
    border-radius:16px;border:1px solid rgba(255,255,255,.1);
    background:rgba(255,255,255,.045);padding:18px;
  }
  .odds-brand-kicker{
    margin:0 0 6px;font-size:.72rem;font-weight:800;letter-spacing:.14em;
    text-transform:uppercase;color:var(--odds-gold);
  }
  .odds-calculator h2{margin:0 0 8px;font-family:'Sora',sans-serif;font-weight:900;color:#fff;letter-spacing:-.02em}
  .odds-intro,.odds-hint,.odds-assumption{color:var(--odds-muted)}
  .odds-intro{margin:0 0 14px;line-height:1.5}
  .odds-mode-seg{border:0;margin:0 0 14px;padding:0;min-width:0}
  .odds-mode-seg legend{
    position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);border:0;
  }
  .odds-mode-seg-track{
    display:grid;grid-template-columns:1fr 1fr;gap:4px;padding:4px;border-radius:14px;
    background:rgba(0,0,0,.28);border:1px solid rgba(251,191,36,.3);
  }
  .odds-mode-option{display:block;margin:0;cursor:pointer}
  .odds-mode-option input{position:absolute;opacity:0;pointer-events:none}
  .odds-mode-option span{
    display:flex;align-items:center;justify-content:center;min-height:44px;padding:8px 10px;
    border-radius:10px;font-weight:800;font-size:.92rem;color:rgba(255,255,255,.55);
    transition:background .15s ease,color .15s ease,box-shadow .15s ease;
  }
  .odds-mode-option input:checked + span{
    background:linear-gradient(135deg,var(--odds-gold),var(--odds-gold-2));
    color:var(--odds-navy);box-shadow:0 6px 18px rgba(251,191,36,.28);
  }
  .odds-mode-option input:focus-visible + span{outline:3px solid var(--odds-gold);outline-offset:2px}
  .odds-mode-instructions{margin:8px 0 0;color:var(--odds-muted);font-size:.78rem;line-height:1.4}
  .odds-calculator.is-estimate-mode .odds-mode-instructions{color:rgba(251,191,36,.85)}
  .odds-grid{display:grid;grid-template-columns:1fr;gap:14px}
  .odds-field{min-width:0;border:0;padding:0;margin:0}
  .odds-field label,.odds-field legend,.odds-option label{display:block;font-weight:800;color:#fff}
  .odds-field legend{margin-bottom:6px}
  .odds-field input,.odds-option input[type="text"]{
    width:100%;min-height:44px;border:1px solid rgba(148,163,184,.55);border-radius:10px;
    padding:9px 11px;font:inherit;background:rgba(255,255,255,.06);color:#fff;
  }
  .odds-field input::placeholder{color:rgba(255,255,255,.35)}
  .odds-field input:focus-visible,.odds-option input:focus-visible,.odds-submit:focus-visible,summary:focus-visible{
    outline:3px solid var(--odds-gold);outline-offset:2px;
  }
  [aria-invalid="true"]{border-color:#f87171!important;box-shadow:0 0 0 1px #f87171}
  .odds-field-error{color:#fecaca;font-weight:700}
  .odds-error-summary{border:2px solid #f87171;border-radius:10px;background:rgba(127,29,29,.35);padding:14px 16px;margin:0 0 14px;color:#fff}
  .odds-error-summary h3{margin:0 0 8px;color:#fff}.odds-error-summary ul{margin:0 0 0 20px}
  .odds-error-summary a{color:#fde68a}
  .odds-options{border-top:1px solid rgba(255,255,255,.12);border-bottom:1px solid rgba(255,255,255,.12);padding:12px 0;margin:16px 0}
  .odds-options summary{min-height:44px;display:flex;align-items:center;font-weight:800;cursor:pointer;color:#fff}
  .odds-option{padding:10px 0}.odds-option>label{display:flex;align-items:center;gap:10px;min-height:44px}
  .odds-assumption{margin:0 0 12px;font-size:.84rem}
  .odds-submit{
    width:100%;min-height:52px;border:0;border-radius:999px;padding:12px 18px;
    background:linear-gradient(135deg,var(--odds-gold),var(--odds-gold-2));
    color:var(--odds-navy);font:900 1.02rem 'Sora',sans-serif;cursor:pointer;
    box-shadow:0 10px 28px rgba(251,191,36,.3);
  }
  .odds-submit:hover{filter:brightness(1.04)}
  .odds-billboard-panel{display:flex;flex-direction:column;justify-content:center;min-height:280px}
  .odds-bill-k{
    margin:0;font-size:.78rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;
    color:rgba(255,255,255,.55);
  }
  .odds-result-placeholder{
    border-radius:14px;border:1px dashed rgba(255,255,255,.2);padding:28px 20px;
    background:rgba(0,0,0,.18);text-align:left;
  }
